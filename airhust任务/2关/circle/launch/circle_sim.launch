<?xml version="1.0"?>
<launch>
  <!-- ==========================================================
       第二关 · 绕圈任务 —— 仿真环境启动文件
       作用：PX4 SITL 飞控 + Gazebo(含 iris 机体) + MAVROS
       注意：本文件只负责“把飞机和飞控搭起来”，不启动任务节点。
             任务节点请在另一个终端用 circle_task.launch 启动
             （因为节点启动时要手动输入 1，且 PX4 也会占用同一终端 stdin）
       ========================================================== -->

  <arg name="gui" default="true"/>
  <!-- PX4 SITL 实例 0 的默认 UDP 端口，换实例要同步改 -->
  <arg name="fcu_url" default="udp://:14540@127.0.0.1:14557"/>

  <!-- 机型与世界：沿用镜像自带的 simulation 包（iris 已加装 mid360 雷达） -->
  <arg name="vehicle" default="iris"/>
  <arg name="world" default="$(find simulation)/worlds/default.world"/>
  <arg name="sdf" default="$(find simulation)/models/iris/model.sdf"/>

  <!-- ================= 1. PX4 SITL + Gazebo + 生成机体 =================
       这三件事是一个整体，由 posix_sitl.launch 一起完成：
         - 启动 PX4 飞控固件（node: sitl）
         - 启动 gzserver / gzclient（Gazebo 界面）
         - 用 spawn_model 把 iris 放进场景（这就是原来缺掉的一步）
       ================================================================= -->
  <include file="$(find px4)/launch/posix_sitl.launch">
    <arg name="vehicle" value="$(arg vehicle)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="sdf" value="$(arg sdf)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="interactive" value="true"/>
  </include>

  <!-- ================= 2. MAVROS 桥接（PX4 版） =================
       原来用的是 mavros/launch/apm.launch（ArduPilot 版），
       与 PX4 SITL 的 MAVLink 端点对不上，必须换成 px4.launch。
       ============================================================ -->
  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
    <arg name="gcs_url" value=""/>
  </include>

</launch>
